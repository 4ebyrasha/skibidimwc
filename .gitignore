# Ignore everything
*

# Allow root files
!/.gitignore
!/.gitattributes
!/LICENSE
!/README.md
!/build.gradle.kts
!/gradle.properties
!/settings.gradle.kts
!/gradlew
!/gradlew.bat
!/gradle/
!/test_logs/
!/test_logs/**

# Allow Gradle wrapper
!/gradle/wrapper/
!/gradle/wrapper/**

# Allow source code
!/src/
!/src/**

# Ignore build output
/build/
/.gradle/
/.idea/
/libs/
/backup/
